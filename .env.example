# GEMINI_API_KEY: Optional for masked Gemini assistance in ClaimKavach MVP v2.
# If absent or left as placeholder, the app automatically runs in deterministic DEMO FALLBACK mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CLAIMKAVACH_DB_PATH: Optional path for local SQLite storage (defaults to claimkavach_local.db)
CLAIMKAVACH_DB_PATH="claimkavach_local.db"

# APP_URL: The URL where this applet is hosted in AI Studio.
APP_URL="MY_APP_URL"
